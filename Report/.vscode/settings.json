{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux", "*.bbl", "*.blg", "*.fls", "*.fdb_latexmk",
    "*.log", "*.toc", "*.lot", "*.lof", "*.out",
    "*.acn", "*.acr", "*.alg", "*.glg", "*.glo", "*.gls",
    "*.idx", "*.ind", "*.ilg", "*.nav", "*.snm", "*.vrb",
    "*.bcf", "*.run.xml", "*.synctex.gz", "*.xmpi"
  ],
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-pdf",
        "%DOC%"
      ],
      "env": {
        "PATH": "/Library/TeX/texbin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    {
      "name": "move-aux-files",
      "command": "bash",
      "args": [
        "%DIR%/move_aux.sh"
      ],
      "env": {
        "PATH": "/Library/TeX/texbin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk then move",
      "tools": ["latexmk", "move-aux-files"]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk then move"
}